{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized observable incident v1",
  "type": "object",
  "required": ["schema_version", "case_id", "window", "devices", "physical_links", "events"],
  "properties": {
    "schema_version": {"const": "baseline-incident-v1"},
    "case_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string"},
    "group_verified": {"type": "boolean"},
    "input_hash": {"type": "string"},
    "window": {
      "type": "object", "required": ["start", "end", "cutoff", "timezone"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "cutoff": {"type": "string"}, "timezone": {"type": "string"}},
      "additionalProperties": false
    },
    "devices": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string"}}, "additionalProperties": false}
    },
    "physical_links": {
      "type": "array",
      "items": {"type": "object", "required": ["u", "v", "evidence_ids"], "properties": {
        "u": {"type": "string"}, "v": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false}
    },
    "events": {
      "type": "array",
      "items": {"type": "object", "required": ["event_id", "device_id", "event_type", "source", "event_time", "record_time"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1}, "device_id": {"type": "string"},
          "event_type": {"type": "string", "minLength": 1}, "source": {"type": "string"},
          "event_time": {"type": ["string", "null"]}, "record_time": {"type": ["string", "null"]},
          "severity": {}, "message": {},
          "observed_fields": {"type": "array", "items": {"type": "string"}},
          "related_device_ids": {"type": "array", "items": {"type": "string"}},
          "link_endpoints": {"type": "array", "items": {"type": "string"}}
        }, "additionalProperties": false}
    },
    "endpoint_context": {"type": "object", "properties": {"source_ip": {}, "sink_ip": {}, "source_az": {}, "sink_az": {}, "alarm_name": {}, "alarm_time": {}}, "additionalProperties": false},
    "observation_coverage": {"type": ["object", "null"], "properties": {"complete": {"type": "boolean"}, "intervals": {"type": "array", "items": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "device_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}}, "additionalProperties": false},
    "input_diagnostics": {"type": "object"}
  },
  "additionalProperties": false
}
